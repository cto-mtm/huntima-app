rules_version = '2';

// Multi-tenant layout: everything an org owns lives under tenants/{slug}.
//
// Fan-facing data is world-readable — fans are anonymous by product design,
// and a hunt is public information printed on a jumbotron. Writes are gated
// on ORG MEMBERSHIP (a document, not a claim) or the platform operator claim.
//
// These rules are largely advisory today: every write flows through the
// Functions API, whose Admin SDK bypasses rules. They exist as cheap
// insurance for the day a client talks to Firestore directly, and as the
// single written statement of who may touch what.
service cloud.firestore {
  match /databases/{database}/documents {

    // The `admin` claim now means PLATFORM OPERATOR (support/ops, never a
    // customer). Never an email address or a domain: anyone who can register
    // that address would otherwise inherit it.
    function isOperator() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Org access is a membership document — instant revoke, no claim-size
    // cap, and one source of truth shared with the API and storage.rules.
    function isMember(slug) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/tenants/$(slug)/members/$(request.auth.uid));
    }

    match /tenants/{slug} {
      // Branding: every fan's first paint needs it and fans are anonymous.
      allow read: if true;
      // Orgs are created and re-branded via the API (which also guards the
      // server-written _meta field). Operator writes are the break-glass.
      allow write: if isOperator();

      match /members/{uid} {
        // Members can see who else runs their org; nobody self-enrolls —
        // membership is granted through the API by an owner or operator.
        allow read: if isMember(slug) || isOperator();
        allow write: if isOperator();
      }

      match /campaigns/{campaignId} {
        // A PUBLISHED hunt is public (fans are anonymous); a DRAFT is not.
        // `read` covers get AND list, so `allow read: if true` would let
        // anyone holding the public Firebase project config enumerate every
        // org's unreleased hunts — names, prizes, and target photo URLs — by
        // slug. Split the two: a get succeeds for a published doc (or a
        // member/operator), and a list is members/operators only. The API
        // only ever serves the single published hunt via the Admin SDK, so
        // this makes the rule state the same guarantee the server enforces.
        allow get: if (resource != null && resource.data.status == 'published')
          || isMember(slug) || isOperator();
        allow list: if isMember(slug) || isOperator();
        allow write: if isMember(slug) || isOperator();
      }

      match /campaign_stats/{campaignId} {
        // Counters are written ONLY by the function (Admin SDK). Members can
        // read their own org's dashboard numbers directly if a client ever
        // wants to.
        allow read: if isMember(slug) || isOperator();
        allow write: if false;
      }
    }

    // Fan progress (`fan_progress/{uid}`) is written ONLY by the Cloud
    // Function via the Admin SDK, through the authenticated /me/progress
    // endpoint — a fan who could write their own doc could write themselves
    // a prize. The same deny-all covers `rate_limits/` (cost-guard counters;
    // docs carry an `expireAt` field — configure a Firestore TTL policy on it
    // so spent windows are reaped automatically) and `personal_spaces/{uid}`
    // (the per-account lock that keeps a first hunt from minting two spaces).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
