rules_version = '2';

// Campaign data is world-readable and staff-writable.
//
// Fans are anonymous by product design — there is no sign-in to gate reads
// behind, and a hunt is public information printed on a jumbotron. Writes are
// a different matter: a campaign edit changes what an entire stadium sees.
service cloud.firestore {
  match /databases/{database}/documents {

    // The `admin` custom claim is the authority. Never an email address or a
    // domain: anyone who can register that address would otherwise inherit it.
    function isStaff() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isStaff();

      match /missions/{missionId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    // Branding: world-readable because every fan's first paint needs it and
    // fans are anonymous; staff-writable because it changes what an entire
    // stadium sees.
    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Fan progress (`fan_progress/{uid}`) is written ONLY by the Cloud Function
    // via the Admin SDK, through the authenticated /me/progress endpoint — the
    // client never touches Firestore directly, so this deny-all is exactly the
    // guard we want: a fan who could write their own doc could write themselves
    // a prize. What the function stores is still the fan's self-reported
    // progress (continuity, not a trusted ledger); making badges
    // server-authoritative is a separate seam — see docs/architecture.md.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
