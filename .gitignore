# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
firebase/functions/lib/

# Firebase Hosting serves from firebase/app/, which scripts/deploy.sh
# populates by copying app/dist/. It is generated, never authored.
firebase/app/

# ── Firebase local state ──────────────────────────────────────
.firebase/
firebase/.firebase/
firebase-debug.log*
firebase-debug.*.log*
ui-debug.log*
firestore-debug.log*

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment ───────────────────────────────────────────────
# .env.example IS committed — it is the template developers copy.
.env
.env.*
!.env.example

# ── Editor / OS ───────────────────────────────────────────────
.DS_Store
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ── Native shells ─────────────────────────────────────────────
# app/ios/ and app/android/ are generated by `npx cap add <platform>`
# and are excluded by default so the scaffold stays lean. Once you start
# customizing native code (entitlements, Info.plist, Gradle, native
# plugins), DELETE the two lines below and commit the folders — at that
# point they are source, not build output.
app/ios/
app/android/

# Built output of the shared contracts package.
shared/dist/
