# Copy to .env before running `npm run dev`:
#   cp .env.example .env          (Git Bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# This points at the LOCAL Firebase Emulator Suite. The `demo-app` project
# id is what makes the emulator run fully offline — no Firebase project,
# no `firebase login`, no credentials.
#
# For a production build, replace this with:
#   VITE_API_URL=https://us-central1-<your-project-id>.cloudfunctions.net/api
VITE_API_URL=http://127.0.0.1:5001/demo-app/us-central1/api
