# Copy to .env before running `npm run dev`:
#   cp .env.example .env          (Git Bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# This points at the LOCAL Firebase Emulator Suite. The `demo-app` project
# id is what makes the emulator run fully offline — no Firebase project,
# no `firebase login`, no credentials.
#
# For a production build, replace this with:
#   VITE_API_URL=https://us-central1-<your-project-id>.cloudfunctions.net/api
VITE_API_URL=http://127.0.0.1:6001/demo-app/us-central1/api

# Public origin of the deployed app, used for the shareable fan-page link and
# QR code in the org console. Leave unset in the browser (the current origin is
# used, so a QR generated in dev opens dev). REQUIRED for a native build, where
# the origin is capacitor://localhost.
# VITE_PUBLIC_BASE_URL=https://huntima.app

# Firebase project config — STAFF sign-in only; fans never authenticate.
# Leave these unset for local dev: the app then targets the offline Auth
# emulator on :10099, which accepts any key. Fill them in for a real deploy.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
